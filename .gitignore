# Virtual environment (each person creates their own; it's big and machine-specific)
.venv/

# Python caches (auto-generated, rebuilt on every run)
__pycache__/
*.pyc
.pytest_cache/

# Jupyter autosave copies
.ipynb_checkpoints/

# Datasets: never commit images (the real dataset lives on Kaggle,
# the fake one is regenerated by src/make_fake_data.py)
data/

# Training outputs: model weights are too big for git (they go to GitHub Releases).
# Small results worth keeping are copied into results/ by hand.
outputs/
*.pt
*.pth

# macOS and editor clutter
.DS_Store
.vscode/
.idea/

# The code zip uploaded to Kaggle (rebuilt from git with `git archive`, see notebooks/02_run_on_kaggle.ipynb)
*.zip
